---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Data Science Dynamics | Machine Learning & Analytics Consulting">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <p class="hero-kicker">Data science consulting</p>
        <h1>Models you can trust. Pipelines you can rerun.</h1>
        <p>
          We build and validate machine learning systems, clean up the data
          underneath them, and ship the open-source tooling we use to do it.
        </p>
        <div class="cta-buttons">
          <a href="#contact" class="btn btn-primary">Start a project</a>
          <a href="#services" class="btn btn-ghost">Explore services</a>
        </div>
      </div>

      <!-- Evaluation panel: an illustrative model-evaluation readout, drawn in
           on load. It stands in for what the work actually produces. -->
      <div class="hero-visual" aria-hidden="true">
        <div class="eval-panel">
          <div class="eval-head">
            <span class="eval-title">Model evaluation</span>
            <span class="eval-pill">holdout, n = 12,480</span>
          </div>
          <svg class="eval-chart" viewBox="0 0 320 220" role="img">
            <defs>
              <linearGradient id="rocFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#3d8bff" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#3d8bff" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g class="eval-grid">
              <line x1="40" y1="20" x2="40" y2="190" />
              <line x1="40" y1="190" x2="300" y2="190" />
              <line x1="105" y1="20" x2="105" y2="190" />
              <line x1="170" y1="20" x2="170" y2="190" />
              <line x1="235" y1="20" x2="235" y2="190" />
              <line x1="40" y1="62.5" x2="300" y2="62.5" />
              <line x1="40" y1="105" x2="300" y2="105" />
              <line x1="40" y1="147.5" x2="300" y2="147.5" />
            </g>
            <line class="eval-chance" x1="40" y1="190" x2="300" y2="20" />
            <path
              class="eval-area"
              d="M40 190 C 60 110, 80 70, 120 48 S 220 24, 300 20 L300 190 Z"
            ></path>
            <path
              class="eval-roc"
              d="M40 190 C 60 110, 80 70, 120 48 S 220 24, 300 20"
            ></path>
            <circle class="eval-dot" cx="120" cy="48" r="4.5"></circle>
            <text x="38" y="206" class="eval-axis">0</text>
            <text x="292" y="206" class="eval-axis">1.0</text>
            <text x="22" y="24" class="eval-axis">1.0</text>
            <text x="150" y="214" class="eval-axis eval-axis--label">
              False positive rate
            </text>
          </svg>
          <div class="eval-metrics">
            <div>
              <span class="eval-metric">0.91</span>
              <span class="eval-metric-label">AUC</span>
            </div>
            <div>
              <span class="eval-metric">0.84</span>
              <span class="eval-metric-label">Recall</span>
            </div>
            <div>
              <span class="eval-metric">0.02</span>
              <span class="eval-metric-label">Calibration error</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-band">
      <div class="hero-band-inner">
        <div class="band-stat">
          <span class="band-number" data-count="35" data-suffix="+">35+</span>
          <span class="band-label">years combined experience</span>
        </div>
        <div class="band-stat">
          <span class="band-number" data-count="5">5</span>
          <span class="band-label">academic institutions</span>
        </div>
        <div class="band-stat">
          <span class="band-number" data-count="10" data-suffix="+">10+</span>
          <span class="band-label">models in production</span>
        </div>
        <div class="band-stat">
          <span class="band-number" data-count="10" data-suffix="+">10+</span>
          <span class="band-label">peer-reviewed publications</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <div class="services-wrap" id="services">
    <section class="services">
      <div class="section-header">
        <span class="section-tag">What we do</span>
        <h2>Specialized data science services</h2>
        <p>
          From exploratory analysis to deployed models and the tooling in
          between. Open any card for the specifics.
        </p>
      </div>
      <div class="services-grid">
        <button type="button" class="service-card" data-modal="ml">
          <span class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg>
          </span>
          <h3>Machine learning</h3>
          <p>
            Classification, regression, and forecasting models matched to your
            data and problem, benchmarked against baselines before they ship.
          </p>
          <span class="service-card-cta">Explore <span class="cta-arrow">&rarr;</span></span>
        </button>
        <button type="button" class="service-card" data-modal="eda">
          <span class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M8 11h6M11 8v6"/></svg>
          </span>
          <h3>Exploratory data analysis</h3>
          <p>
            Statistical summaries, anomaly detection, and visualization that
            tell you what is in the data before anything is built on it.
          </p>
          <span class="service-card-cta">Explore <span class="cta-arrow">&rarr;</span></span>
        </button>
        <button type="button" class="service-card" data-modal="dataeng">
          <span class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
          </span>
          <h3>Data engineering &amp; BI</h3>
          <p>
            ETL pipelines, warehouses, and dashboards built for reliability, so
            the numbers are current and people actually use them.
          </p>
          <span class="service-card-cta">Explore <span class="cta-arrow">&rarr;</span></span>
        </button>
        <button type="button" class="service-card" data-modal="tools">
          <span class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5L22 9l-3-3-2.3 1.3z"/><path d="M12 12l-8.5 8.5a1.5 1.5 0 0 0 2 2L14 14"/></svg>
          </span>
          <h3>Custom tool development</h3>
          <p>
            Python libraries, model diagnostics, and automated evaluation
            pipelines built to production standards and documented for handoff.
          </p>
          <span class="service-card-cta">Explore <span class="cta-arrow">&rarr;</span></span>
        </button>
        <button type="button" class="service-card" data-modal="training">
          <span class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8l10-5 10 5-10 5z"/><path d="M6 10v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 8v6"/></svg>
          </span>
          <h3>Training &amp; education</h3>
          <p>
            Workshops and university-level courses in statistics, Python, and
            machine learning, taught by people who teach for a living.
          </p>
          <span class="service-card-cta">Explore <span class="cta-arrow">&rarr;</span></span>
        </button>
        <button type="button" class="service-card" data-modal="research">
          <span class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v5l5 9a2 2 0 0 1-1.8 3H5.8A2 2 0 0 1 4 17l5-9z"/><path d="M8 15h8"/></svg>
          </span>
          <h3>Research collaboration</h3>
          <p>
            Study design through publication, with rigorous validation and
            co-authorship where it fits.
          </p>
          <span class="service-card-cta">Explore <span class="cta-arrow">&rarr;</span></span>
        </button>
      </div>
    </section>
  </div>

  <!-- Selected work -->
  <section class="work" id="work">
    <div class="section-header">
      <span class="section-tag">Selected work</span>
      <h2>Things we have built and shown</h2>
    </div>
    <div class="work-grid">
      <a
        class="work-card work-card--wide"
        href="https://lshpaner.github.io/eda_toolkit_docs"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="work-media work-media--logo">
          <img src="/eda_toolkit_logo.svg" alt="" width="300" height="104" />
        </div>
        <div class="work-body">
          <span class="work-kind">Open-source library</span>
          <h3>EDA Toolkit</h3>
          <p>
            A Python library for fast, reproducible exploratory data analysis.
            Used in research groups and under contract as a Taylor &amp; Francis
            textbook.
          </p>
        </div>
      </a>
      <a class="work-card" href="/choc-2026">
        <div class="work-media">
          <img
            src="/images/choc_pediatric_lifespan_2026.webp"
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="work-body">
          <span class="work-kind">Best Poster Award, 2026</span>
          <h3>Reproducible EDA for a pediatric diabetes cohort</h3>
        </div>
      </a>
      <a
        class="work-card"
        href="https://youtu.be/X0xQrCQTsKw?si=MTNSFgauhZLFRxMk"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="work-media">
          <img
            src="/images/EDA_Toolkit_JupyterCon2025.webp"
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="work-body">
          <span class="work-kind">JupyterCon 2025 tutorial</span>
          <h3>Streamlining EDA in Jupyter</h3>
        </div>
      </a>
    </div>
    <div class="work-logos">
      <span>Presented at</span>
      <a href="https://jupytercon2025.sched.com/event/28H3P/eda-toolkit-tutorial-on-streamlining-exploratory-data-analysis-in-jupyter-leon-shpaner-ucla-health-oscar-gil-university-of-california-riverside" target="_blank" rel="noopener noreferrer"><img src="/jupytercon-speaker-badge.png" width="520" height="520" alt="JupyterCon 2025" loading="lazy" /></a>
      <a href="https://youtu.be/Trxoq2B8E9w?si=4GdxsaXBQv0KTldj" target="_blank" rel="noopener noreferrer"><img src="/BIT25_logo.png" width="900" height="290" alt="Bio-IT World" loading="lazy" /></a>
      <a href="https://data-science-salon-podcast.simplecast.com/episodes/reproducible-eda-building-trustworthy-analytics-pipelines-nKzHV0Vh" target="_blank" rel="noopener noreferrer"><img src="/DSS-PODCAST-LOGO.png" width="520" height="520" alt="Data Science Salon podcast" loading="lazy" /></a>
      <a href="/portfolio" class="text-link">Full portfolio &rarr;</a>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="about">
    <div class="about-content">
      <div class="section-header">
        <span class="section-tag">Who we are</span>
        <h2>Practitioners, professors, and clinicians</h2>
      </div>
      <div class="about-team">
        <div class="team-member">
          <img
            src="/photos/leonshpaner.jpg"
            width="270"
            height="270"
            loading="lazy"
            decoding="async"
            alt="Leon Shpaner"
            class="team-photo"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://www.leonshpaner.com"
                target="_blank"
                rel="noopener noreferrer">Leon Shpaner, M.S.<br /> Co-Founder</a
              >
            </h3>
            <p>
              is a Data Scientist at UCLA Health with over 15 years of
              experience across healthcare, financial services, and education.
              He serves as an adjunct professor at the University of San Diego,
              where he teaches statistics and machine learning in the M.S. in
              Applied Artificial Intelligence program. He has contributed to
              applied predictive modeling research, co-developed a production-grade EDA
              toolkit contracted for publication with Taylor & Francis, and
              presented at JupyterCon 2025.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/Oscar_LinkedIn_Pic.jpeg"
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
            alt="Oscar Gil"
            class="team-photo"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://oscargildata.com"
                target="_blank"
                rel="noopener noreferrer">Oscar Gil, M.S. <br /> Co-Founder</a
              >
            </h3>
            <p>
              is a Data Scientist at the University of California, Riverside,
              with over ten years of experience in the education data management
              industry. He excels in data warehousing, analytics, machine
              learning, SQL, Python, R, and report authoring, and holds an M.S.
              in Applied Data Science from the University of San Diego. He has
              co-developed analytical tools and pipelines deployed in research
              and institutional settings, and presented alongside Leon at
              JupyterCon 2025.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/Ebrahim_Tarshizi.jpg"
            width="315"
            height="400"
            loading="lazy"
            decoding="async"
            alt="Ebrahim Tarshizi"
            class="team-photo photo-offset"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://onlinedegrees.sandiego.edu/faculty/ebrahim-k-tarshizi/"
                target="_blank"
                rel="noopener noreferrer">Ebrahim Tarshizi, PhD</a
              >
            </h3>
            <p>
              is a Professor of Practice and Academic Director of the Applied
              Data Science (MS-ADS) and Applied Artificial Intelligence (MS-AAI)
              programs at the University of San Diego's Shiley-Marcos School of
              Engineering. A former senior technical advisor for the CDC's
              National Institute for Occupational Safety and Health (NIOSH) and
              visiting scholar at UCSD's San Diego Supercomputer Center, he
              holds a PhD in Geo-Engineering from the University of Nevada,
              Reno, an MSc in Data Science from Michigan Tech, and an MBA from
              UNR. He has published widely in international journals and
              received numerous university, national, and international awards.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/Giuseppe_Saitta_urologo.jpeg"
            width="480"
            height="480"
            loading="lazy"
            decoding="async"
            alt="Giuseppe Saitta"
            class="team-photo"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://www.giuseppesaittaurologo.it"
                target="_blank"
                rel="noopener noreferrer">Giuseppe Saitta, M.D.</a
              >
            </h3>
            <p>
              is a urologist at the Istituto Clinico Città Studi (ICCS) in
              Milan, Italy, specializing in endourology, the surgical treatment
              of prostatic diseases including benign prostatic hyperplasia and
              prostate cancer, and the minimally invasive treatment of renal and
              ureteral stones. He earned his medical degree summa cum laude and
              completed his urology specialization with top honors at
              Vita-Salute San Raffaele University, training further in laser
              techniques for prostatic hyperplasia at ICUA in Madrid and in
              upper urinary tract oncology at the Fundació Puigvert in
              Barcelona.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/Gary_Takahashi.jpg"
            width="548"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Gary Takahashi, M.D., M.S."
            class="team-photo"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://github.com/gwtakahashi"
                target="_blank"
                rel="noopener noreferrer">Gary Takahashi, M.D., M.S.</a
              >
            </h3>
            <p>
              is a hematologist-oncologist previously at Oregon Health & Science
              University where he was assistant professor in the Department of
              Medicine, and involved in clinical trials research. He completed
              his subspecialty training at the University of Washington and the
              Fred Hutchinson Cancer Research Center. He is now adjunct
              professor at the University of San Diego, having received an M.S.
              in Applied Artificial Intelligence. In addition, he has a B.S. in
              mathematics from Stanford University. He is interested in
              applications of artificial intelligence in informatics and
              healthcare.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/isabella_oakes.jpg"
            width="512"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Isabella Oakes, M.S."
            class="team-photo photo-lower"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://github.com/isabellaoakes"
                target="_blank"
                rel="noopener noreferrer">Isabella Oakes, M.S.</a
              >
            </h3>
            <p>
              is a Data Scientist at NAVEX and adjunct professor at the
              University of San Diego, teaching for the Applied AI and Data
              Science programs. She obtained her M.Sc. in Applied Data Science
              from USD in 2022. Working in the ethics and compliance software
              industry, she is focused on utilizing rapidly evolving AI tools in
              ethical ways to improve products, business practices, and customer
              experiences. She is passionate about improving workplace culture
              and supporting healthy ethics and compliance programs.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/sean_torres.jpeg"
            width="480"
            height="480"
            loading="lazy"
            decoding="async"
            alt="Sean Michael Torres"
            class="team-photo photo-offset"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://github.com/seantorres"
                target="_blank"
                rel="noopener noreferrer">Sean Michael Torres, M.S.</a
              >
            </h3>
            <p>
              is a data analyst with experience across public service,
              operations, and business analytics. Focused on workflow
              automation, data quality, business intelligence, and predictive
              analytics. Builds Python reporting solutions, ETL workflows,
              Tableau dashboards, and data validation processes that support
              operational decision-making and improve efficiency.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/Nick_Shpaner.jpg"
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Nicholas J. Shpaner"
            class="team-photo"
          />
          <div class="team-bio">
            <h3>
              <a
                href="https://github.com/nshpaner"
                target="_blank"
                rel="noopener noreferrer">Nicholas J. Shpaner</a
              >
            </h3>
            <p>
              is an aspiring Data Scientist, currently pursuing his Bachelor's
              degree at the University of California Merced. He currently works
              as a special projects assistant with UC Merced's Division of
              Undergraduate Education, and has experience in Python, R, and
              Excel. He has contributed to UAP research and analysis, as well as
              modeling search interest in Julian Pie Company data.
            </p>
          </div>
        </div>
        <div class="team-member">
          <img
            src="/photos/maxime_boulat.JPEG"
            width="480"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Maxime Boulat"
            class="team-photo photo-lower"
          />
          <div class="team-bio">
            <h3>Maxime Boulat</h3>
            <p>
              is a software engineer with over ten years of experience
              developing apps in VoIP, location tracking, email protocols,
              sports sensors, and medical devices. He spent five years as a
              software architect on next-generation glucose monitoring apps for
              an industry leader. Over the past two years, he has redirected his
              attention to AI, both as an early adopter and as a scholar, and is
              a soon-to-be graduate of the University of San Diego's M.S. in
              Applied Artificial Intelligence program. Outside of work, Maxime
              enjoys cooking, science fiction, and fitness.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <div class="contact-wrap" id="contact">
    <div class="section-header">
      <span class="section-tag">Get in touch</span>
      <h2>Let's talk about your data</h2>
      <p>Tell us what you are working on. We reply within two business days.</p>
    </div>
    <section class="contact">
      <div class="contact-container">
        <div class="contact-info">
          <h2>Contact Information</h2>
          <p>
            We're here to help with your data science needs. Whether you're
            looking for consulting services, training programs, or research
            collaboration, we'd love to hear from you.
          </p>
          <div class="contact-details">
            <div class="contact-item">
              <div class="contact-item-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-10 5L2 7"></path>
                </svg>
              </div>
              <div class="contact-item-text">
                <div class="contact-item-label">Email</div>
                <a href="mailto:info@datasciencedynamics.com"
                  >info@datasciencedynamics.com</a
                >
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-item-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="contact-item-text">
                <div class="contact-item-label">Location</div>
                <div class="contact-item-value">Southern California</div>
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-item-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 6v6l4 2"></path>
                </svg>
              </div>
              <div class="contact-item-text">
                <div class="contact-item-label">Response Time</div>
                <div class="contact-item-value">Within two business days</div>
              </div>
            </div>
          </div>
        </div>
        <div class="contact-form">
          <form action="https://api.web3forms.com/submit" method="POST">
            <input
              type="hidden"
              name="access_key"
              value="b7b5c224-d9d7-4f76-819b-172bf09bba70"
            />
            <input
              type="hidden"
              name="subject"
              value="New Contact Form Submission from Data Science Dynamics"
            />
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send Message</button>
          </form>
        </div>
      </div>
    </section>
  </div>

  <!-- Service Modals -->
  <div
    class="modal-overlay"
    id="modalOverlay"
    onclick="closeModalOutside(event)"
  >
    <div class="modal">
      <button class="modal-close" onclick="closeModal()">&#10005;</button>
      <div class="modal-body">
        <h2 id="modalTitle"></h2>
        <p id="modalDesc"></p>
        <div class="modal-section-title">What We Offer</div>
        <ul id="modalOffers"></ul>
        <div class="modal-section-title">Why Choose Us</div>
        <ul id="modalWhy"></ul>
        <div class="modal-cta">
          <a href="#contact" class="btn btn-primary" onclick="closeModal()"
            >Let's Talk</a
          >
          <span>Get a free consultation</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const modalData = {
    ml: {
      title: "Machine Learning Applications",
      desc: "We build custom ML pipelines end to end, from feature engineering and model selection through evaluation and production deployment. Our priority is picking the right approach for your problem and proving it works, not reaching for the trendiest model.",
      offers: [
        "Predictive models for classification, regression, and forecasting, matched to your data and problem",
        "Automated model selection and tuning, so results are systematic and repeatable rather than hand-tuned guesswork",
        "Rigorous evaluation and validation, so you know a model works before it ships",
        "Reproducible pipelines with experiment tracking, so results hold up and can be handed off",
        "Deployment-ready delivery that fits into your existing workflow",
      ],
      why: [
        "We benchmark candidate approaches against each other to identify the right one, rather than defaulting to a favorite",
        "Every model is measured against naive baselines, so you never pay for complexity that does not earn its keep",
        "Built on our own tooling (the model_tuner library) for systematic, auditable tuning",
        "Methods grounded in rigorous evaluation, the same standard we hold in published research",
      ],
    },
    eda: {
      title: "Exploratory Data Analysis",
      desc: "Before any model is built, the data needs to be understood. Our EDA services uncover patterns, detect anomalies, assess distributions, and produce publication-quality visualizations that drive informed decision-making.",
      offers: [
        "Comprehensive statistical summaries and distribution analysis",
        "Correlation analysis and multivariate relationship exploration",
        "Anomaly and outlier detection with contextual interpretation",
        "Interactive dashboards and publication-ready visualizations",
        "Data quality audits and cleaning recommendations",
      ],
      why: [
