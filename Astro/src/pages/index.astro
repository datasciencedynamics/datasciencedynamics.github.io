    },
    research: {
      title: "Research Collaboration",
      desc: "We partner with academic institutions and research teams to tackle complex analytical challenges. From study design through publication, we bring methodological rigor and machine learning expertise to collaborative projects.",
      offers: [
        "Co-design of analytical frameworks for social science and applied research studies",
        "Machine learning applied to conflict data and social science research",
        "Temporal validation strategies for time-sensitive research questions",
        "Statistical methodology consulting (survival analysis, causal inference)",
        "Co-authorship and support through the full publication process",
      ],
      why: [
        "Active publications in peer-reviewed ML and applied research journals",
        "Experience with ACLED conflict data and geospatial analysis",
        "Rigorous approach to temporal validation and avoiding data leakage",
        "Collaborative mindset: we integrate seamlessly with your team",
      ],
    },
  };

  function openModal(key) {
    const data = modalData[key];
    document.getElementById("modalTitle").textContent = data.title;
    document.getElementById("modalDesc").textContent = data.desc;
    document.getElementById("modalOffers").innerHTML = data.offers
      .map((item) => `<li>${item}</li>`)
      .join("");
    document.getElementById("modalWhy").innerHTML = data.why
      .map((item) => `<li>${item}</li>`)
      .join("");
    document.getElementById("modalOverlay").classList.add("active");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    document.getElementById("modalOverlay").classList.remove("active");
    document.body.style.overflow = "";
  }

  function closeModalOutside(e) {
    if (e.target === document.getElementById("modalOverlay")) closeModal();
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });

  document.querySelectorAll("[data-modal]").forEach((btn) => {
    btn.addEventListener("click", () => openModal(btn.dataset.modal));
  });

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      closeModal();
      const target = document.querySelector(this.getAttribute("href"));
      if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Count the band numbers up once they scroll into view.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce) {
    const countUp = (el) => {
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix || "";
      const start = performance.now();
      const dur = 1200;
      const tick = (now) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            countUp(entry.target);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll(".band-number").forEach((el) => io.observe(el));
  }
</script>
