---
// Self-hosted fonts (served from this origin, no Google Fonts round trip).
// Only the weights the stylesheet uses.
import "@fontsource/inter/latin-300.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Data Science Dynamics offers expert data science consulting specializing in machine learning, predictive modeling, and advanced analytics for organizations across industries.",
  image = "/og-image.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#185FA5" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Data Science Dynamics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Light is the default. Dark applies only if the visitor clicked the
      // toggle earlier in this browser session (session cookie shared with
      // apps.datasciencedynamics.com). Nothing persists between visits.
      if (/(?:^|; )dsd_session_theme=dark(?:;|$)/.test(document.cookie)) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- particles.js is a classic (non-module) script: it relies on sloppy
         mode, so it is served as-is from /public rather than bundled.
         `defer` keeps it off the critical path. -->
    <script is:inline defer src="/js/particles.min.js"></script>
  </head>
  <body class:list={{ home: isHome }}>
    <div id="particles-js"></div>

    <header class:list={{ "on-dark": isHome }}>
      <nav class="navbar">
        <div class="logo">
          <a href="/">
            <img
              class="logo-light"
              src="/data_science_dynamics_logo.svg"
              alt="Data Science Dynamics"
              width="380"
              height="104"
              style="max-width: 300px;"
            />
            <img
              class="logo-dark"
              src="/data_science_dynamics_logo_white.svg"
              alt="Data Science Dynamics"
              width="380"
              height="104"
              style="max-width: 300px;"
            />
          </a>
        </div>

        <ul class="nav-links">
          <li><a href="/#services">Services</a></li>
          <li><a href="/#work">Work</a></li>
          <li><a href="/portfolio">Portfolio</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="https://apps.datasciencedynamics.com">Apps</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
          <li class="nav-theme-item">
            <button class="theme-menu-btn" type="button" data-theme-toggle>
              <span class="label-dark"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                  ></path></svg
                >Dark mode</span
              >
              <span class="label-light"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><circle cx="12" cy="12" r="4"></circle><path
                    d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                  ></path></svg
                >Light mode</span
              >
            </button>
          </li>
        </ul>

        <div class="nav-actions">
          <button
            class="theme-toggle"
            id="themeToggle"
            type="button"
            aria-label="Switch color theme"
          >
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
              ></path></svg
            >
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path></svg
            >
          </button>
          <button class="nav-toggle" aria-label="Toggle navigation">☰</button>
        </div>
      </nav>
    </header>

    <slot />

    <footer>
      <div class="footer-content">
        <div>
          <img
            src="/data_science_dynamics_logo_white.svg"
            alt="Data Science Dynamics"
            class="footer-logo"
            width="380"
            height="104"
            loading="lazy"
            style="max-width: 300px; margin-bottom: 15px;"
          />
          <p class="footer-about">
            Transforming complex data challenges into actionable intelligence
            through expert consulting, advanced analytics, and collaborative
            research.
          </p>
        </div>
        <div class="footer-section">
          <h4>Services</h4>
          <ul>
            <li><a href="/#services">Machine Learning</a></li>
            <li><a href="/#services">Data Analysis</a></li>
            <li><a href="/#services">Custom Tools</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Company</h4>
          <ul>
            <li><a href="/#about">About Us</a></li>
            <li><a href="/#contact">Contact</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="https://apps.datasciencedynamics.com">Apps</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Data Science Dynamics. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Bundled by Astro: minified, cached, and loaded as a deferred module so
      // it never blocks first paint.

      // Theme toggle
      (function () {
        const root = document.documentElement;
        const btn = document.getElementById("themeToggle");
        const current = () =>
          root.getAttribute("data-theme") === "dark" ? "dark" : "light";
        const label = () =>
          btn.setAttribute(
            "aria-label",
            current() === "dark"
              ? "Switch to light theme"
              : "Switch to dark theme",
          );
        label();
        btn.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          const shared = /(^|\.)datasciencedynamics\.com$/.test(
            location.hostname,
          );
          document.cookie =
            "dsd_session_theme=" +
            next +
            "; path=/; SameSite=Lax" +
            (shared ? "; domain=.datasciencedynamics.com" : "") +
            (location.protocol === "https:" ? "; Secure" : "");
          label();
        });
        // The "Dark mode / Light mode" item in the mobile menu does the same.
        document
          .querySelectorAll("[data-theme-toggle]")
          .forEach((el) => el.addEventListener("click", () => btn.click()));
      })();

      // Mobile nav toggle
      const toggle = document.querySelector(".nav-toggle");
      const navLinks = document.querySelector(".nav-links");
      const navItems = document.querySelectorAll(".nav-links a");

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        navLinks.classList.toggle("active");
      });

      navItems.forEach((link) => {
        link.addEventListener("click", () =>
          navLinks.classList.remove("active"),
        );
      });

      document.addEventListener("click", (e) => {
        if (
          navLinks.classList.contains("active") &&
          !navLinks.contains(e.target) &&
          !toggle.contains(e.target)
        ) {
          navLinks.classList.remove("active");
        }
      });

      // Particles. Skipped for visitors who asked for reduced motion, and
      // lighter on small screens where the canvas competes with scrolling.
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const smallScreen = window.matchMedia("(max-width: 768px)").matches;
      // Home has the dark hero backdrop; other pages stay light.
      const onDark = document.body.classList.contains("home");
      // The deferred particles.min.js may run before or after this module, so
      // wait for `load`, by which point every deferred script has executed.
      const startParticles = () => {
        if (!reduceMotion && (window as any).particlesJS) {
          initParticles(smallScreen ? 22 : 45);
        }
      };
      if (document.readyState === "complete") startParticles();
      else window.addEventListener("load", startParticles, { once: true });

      function initParticles(count: number) {
      (window as any).particlesJS("particles-js", {
        particles: {
          number: { value: count, density: { enable: true, value_area: 900 } },
          color: {
            value: onDark
              ? ["#8cc0ff", "#3d8bff", "#ffffff"]
              : ["#185FA5", "#2b7fd4", "#4a9fe0"],
          },
          shape: { type: "circle" },
          opacity: {
            value: 0.55,
            random: true,
            anim: { enable: true, speed: 0.6, opacity_min: 0.2, sync: false },
          },
          size: {
            value: 3.5,
            random: true,
            anim: { enable: true, speed: 1, size_min: 1.2, sync: false },
          },
          line_linked: {
            enable: true,
            distance: 140,
            color: onDark ? "#8cc0ff" : "#185FA5",
            opacity: onDark ? 0.22 : 0.3,
            width: 1,
          },
          move: {
            enable: true,
            speed: 0.7,
            direction: "none",
            random: true,
            straight: false,
            out_mode: "out",
            bounce: false,
          },
        },
        interactivity: {
          detect_on: "canvas",
          events: {
            hover: { enable: true, mode: "grab" },
            click: { enable: false },
            resize: true,
          },
          modes: {
            grab: { distance: 180, line_linked: { opacity: 0.45 } },
            push: { particles_nb: 2 },
          },
        },
        retina_detect: true,
      });
      }

      // Scroll-aware navbar. On the home page the header starts dark over
      // the hero and turns light once the hero has scrolled past it.
      const header = document.querySelector("header") as HTMLElement;
      const hero = document.querySelector(".hero") as HTMLElement | null;
      const updateHeader = () => {
        header.classList.toggle("scrolled", window.scrollY > 80);
        if (hero && document.body.classList.contains("home")) {
          const heroBottom = hero.getBoundingClientRect().bottom;
          header.classList.toggle("on-dark", heroBottom > header.offsetHeight);
        }
      };
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
      window.addEventListener("resize", updateHeader);

      // Prevent right-click / drag on images
      document.addEventListener("contextmenu", (e) => {
        if (e.target.tagName === "IMG") e.preventDefault();
      });
      document.addEventListener("dragstart", (e) => {
        if (e.target.tagName === "IMG") e.preventDefault();
      });
    </script>
  </body>
</html>
